rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isVerifiedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'kmdfoysal693@gmail.com';
    }

    function isAdmin() {
      return isVerifiedAdminEmail() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == request.auth.uid &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.displayName is string && data.displayName.size() <= 120 &&
        data.role == 'user' &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdmission(data) {
      return data.keys().hasAll([
          'trackingId', 'ownerUid', 'studentName', 'fatherName', 'dateOfBirth',
          'department', 'departmentId', 'className', 'classIndex', 'residentialType',
          'residentialKey', 'mobile', 'email', 'address', 'status', 'submittedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'trackingId', 'ownerUid', 'studentName', 'fatherName', 'dateOfBirth',
          'department', 'departmentId', 'className', 'classIndex', 'residentialType',
          'residentialKey', 'mobile', 'email', 'address', 'status', 'submittedAt',
          'createdAt', 'updatedAt'
        ]) &&
        data.trackingId is string && data.trackingId.size() >= 4 && data.trackingId.size() <= 40 &&
        data.trackingId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.studentName is string && data.studentName.size() >= 2 && data.studentName.size() <= 120 &&
        data.fatherName is string && data.fatherName.size() >= 2 && data.fatherName.size() <= 120 &&
        data.dateOfBirth is string && data.dateOfBirth.size() <= 32 &&
        data.department is string && data.department.size() >= 2 && data.department.size() <= 120 &&
        data.departmentId is string && data.departmentId.size() <= 64 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 120 &&
        data.classIndex is int && data.classIndex >= 0 && data.classIndex <= 50 &&
        data.residentialType is string && data.residentialType.size() >= 2 && data.residentialType.size() <= 80 &&
        data.residentialKey in ['boarding', 'day_care', 'non_residential'] &&
        data.mobile is string && data.mobile.size() >= 11 && data.mobile.size() <= 15 &&
        data.mobile.matches('^01[3-9][0-9]{8}$') &&
        data.email is string && data.email.size() <= 160 &&
        data.address is string && data.address.size() >= 4 && data.address.size() <= 400 &&
        data.status in ['pending', 'reviewed', 'approved', 'rejected'] &&
        data.submittedAt is string && data.submittedAt.size() <= 80 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStudent(data) {
      return data.keys().hasAll([
          'studentRoll', 'ownerUid', 'accountType', 'name', 'fatherName', 'phone',
          'email', 'department', 'className', 'session', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'studentRoll', 'ownerUid', 'accountType', 'name', 'fatherName', 'phone',
          'email', 'department', 'className', 'session', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.studentRoll is string && data.studentRoll.size() >= 3 && data.studentRoll.size() <= 40 &&
        data.studentRoll.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.ownerUid is string && data.ownerUid.size() <= 128 &&
        data.accountType in ['student_account', 'google_signin'] &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        data.fatherName is string && data.fatherName.size() <= 120 &&
        data.phone is string && data.phone.size() <= 15 &&
        data.email is string && data.email.size() <= 160 &&
        data.department is string && data.department.size() >= 1 && data.department.size() <= 120 &&
        data.className is string && data.className.size() >= 1 && data.className.size() <= 120 &&
        data.session is string && data.session.size() >= 1 && data.session.size() <= 64 &&
        data.status in ['active', 'inactive'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Users collection: strict owner/admin PII isolation, no self-escalation
    match /users/{userId} {
      allow get: if isValidId(userId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == userId));
      allow list: if isVerifiedAdminEmail();
      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidUser(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        (isAdmin() || request.auth.uid == userId) &&
        isValidUser(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().role == existing().role &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'displayName', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(userId);
    }

    // Admins roster: strictly read-only for verified user checking self or verified admin
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isVerifiedAdminEmail() || (isVerifiedUser() && request.auth.uid == adminId));
      allow list: if isVerifiedAdminEmail();
      allow write: if false;
    }

    // Online Admissions: schema-validated submit; PII read/list/update/delete strictly owner or verified admin
    match /admissions/{admissionId} {
      allow get: if isValidId(admissionId) && (
        isAdmin() || (isVerifiedUser() && existing().ownerUid == request.auth.uid)
      );
      allow list: if isVerifiedAdminEmail() || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(admissionId) &&
        isValidAdmission(incoming()) &&
        incoming().status == 'pending' &&
        (incoming().ownerUid == '' || (isVerifiedUser() && incoming().ownerUid == request.auth.uid)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isAdmin() &&
        isValidId(admissionId) &&
        isValidAdmission(incoming()) &&
        incoming().trackingId == existing().trackingId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(admissionId);
    }

    // Student Registrations: schema-validated submit; PII read/list/update/delete strictly owner or verified admin
    match /students/{studentId} {
      allow get: if isValidId(studentId) && (
        isAdmin() || (isVerifiedUser() && existing().ownerUid == request.auth.uid)
      );
      allow list: if isVerifiedAdminEmail() || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);
      allow create: if isValidId(studentId) &&
        isValidStudent(incoming()) &&
        incoming().status == 'active' &&
        (incoming().ownerUid == '' || (isVerifiedUser() && incoming().ownerUid == request.auth.uid)) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(studentId) &&
        isValidStudent(incoming()) &&
        incoming().studentRoll == existing().studentRoll &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'fatherName', 'phone', 'department', 'className', 'status', 'updatedAt'])) ||
          (isVerifiedUser() && existing().ownerUid == request.auth.uid && incoming().status == existing().status && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'fatherName', 'phone', 'updatedAt']))
        );
      allow delete: if isAdmin() && isValidId(studentId);
    }
  }
}
