{
  "entities": {
    "User": {
      "title": "User",
      "description": "Authenticated user profile stored by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 160,
          "description": "Verified email address."
        },
        "displayName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Display name from Google account."
        },
        "role": {
          "type": "string",
          "enum": ["user"],
          "description": "Default non-privileged role assigned at registration."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when user profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest profile update."
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Admission": {
      "title": "Admission",
      "description": "Online admission application submitted for Darus Salam Nurani & Mohila Hafizia Madrasa.",
      "type": "object",
      "properties": {
        "trackingId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique admission tracking code (e.g. ADM-2026-1234)."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Firebase UID of the applicant if signed in, otherwise empty string."
        },
        "studentName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Full name of the student applicant."
        },
        "fatherName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Father or guardian name."
        },
        "dateOfBirth": {
          "type": "string",
          "minLength": 0,
          "maxLength": 32,
          "description": "Date of birth string."
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Selected academic department."
        },
        "departmentId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 64,
          "description": "Department identifier."
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Selected jamat or class name."
        },
        "classIndex": {
          "type": "integer",
          "description": "Zero-based index of the class within the department."
        },
        "residentialType": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Residential option label."
        },
        "residentialKey": {
          "type": "string",
          "enum": ["boarding", "day_care", "non_residential"],
          "description": "Canonical residential option key."
        },
        "mobile": {
          "type": "string",
          "minLength": 11,
          "maxLength": 15,
          "pattern": "^01[3-9][0-9]{8}$",
          "description": "11-digit Bangladeshi mobile number."
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Optional contact email address."
        },
        "address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 400,
          "description": "Present residential address."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "reviewed", "approved", "rejected"],
          "description": "Current review status of the admission application."
        },
        "submittedAt": {
          "type": "string",
          "minLength": 0,
          "maxLength": 80,
          "description": "Localized submission timestamp label."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of admission creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "trackingId",
        "ownerUid",
        "studentName",
        "fatherName",
        "dateOfBirth",
        "department",
        "departmentId",
        "className",
        "classIndex",
        "residentialType",
        "residentialKey",
        "mobile",
        "email",
        "address",
        "status",
        "submittedAt",
        "createdAt",
        "updatedAt"
      ]
    },
    "Student": {
      "title": "Student",
      "description": "Registered student portal account record stored without secret credentials.",
      "type": "object",
      "properties": {
        "studentRoll": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique student roll number (e.g. STD-1448-1001)."
        },
        "ownerUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "description": "Firebase UID if signed in with Google, otherwise empty string."
        },
        "accountType": {
          "type": "string",
          "enum": ["student_account", "google_signin"],
          "description": "Registration method."
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Student full name."
        },
        "fatherName": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120,
          "description": "Father name."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 15,
          "description": "Student or guardian mobile number."
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 160,
          "description": "Student email address."
        },
        "department": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Enrolled academic department."
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Enrolled class or jamat."
        },
        "session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Academic session label."
        },
        "status": {
          "type": "string",
          "enum": ["active", "inactive"],
          "description": "Student portal account status."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of registration."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": [
        "studentRoll",
        "ownerUid",
        "accountType",
        "name",
        "fatherName",
        "phone",
        "email",
        "department",
        "className",
        "session",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminMarker": {
      "title": "AdminMarker",
      "description": "Trusted administrator lookup document keyed by Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Admin Firebase UID."
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 160,
          "description": "Admin email."
        }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Private user profile documents keyed by Firebase Auth UID."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminMarker" },
      "description": "Read-only admin roster keyed by Firebase Auth UID."
    },
    "/admissions/{admissionId}": {
      "schema": { "$ref": "#/entities/Admission" },
      "description": "Online admission form submissions keyed by trackingId."
    },
    "/students/{studentId}": {
      "schema": { "$ref": "#/entities/Student" },
      "description": "Registered student accounts keyed by student ID."
    }
  }
}
